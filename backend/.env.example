# ── Backend Chef IA — variables d'environnement ──
# Copiez ce fichier en `.env` et renseignez vos clés.
# Ces clés ne quittent JAMAIS le serveur — le front ne les voit pas.

# Clé Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-VOTRE_CLE_ICI

# Clé ElevenLabs pour la synthèse vocale (https://elevenlabs.io/)
ELEVENLABS_API_KEY=

# Clés photos (au moins une est recommandée pour de belles vignettes)
PEXELS_API_KEY=
UNSPLASH_API_KEY=

# Origine front autorisée (pour le CORS) — séparer plusieurs origines par des virgules
ALLOWED_ORIGINS=http://localhost:5173

# Port d'écoute (par défaut 3001)
PORT=3001

# Limite de requêtes par IP par minute (anti-abus simple)
RATE_LIMIT_MAX=60
