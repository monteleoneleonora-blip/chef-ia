# Variables d'environnement Chef IA (front)
# Copiez ce fichier en `.env`.

# MODE 1 — Backend proxy (RECOMMANDE pour la prod)
# Demarre `cd backend && npm install && npm run dev` puis pointe ici.
# Avec ce mode, AUCUNE cle n'est exposee au navigateur.
VITE_API_BASE=http://localhost:3001

# MODE 2 — Direct browser (legacy / dev rapide)
# Si VITE_API_BASE n'est pas defini, le front utilise les cles ci-dessous
# en passant par le proxy Vite. Les cles se retrouvent dans le bundle prod.
# VITE_ANTHROPIC_API_KEY=sk-ant-...
# VITE_ELEVENLABS_API_KEY=...
# VITE_PEXELS_KEY=...
# VITE_UNSPLASH_KEY=...
